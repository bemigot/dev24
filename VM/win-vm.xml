<domain type="kvm">
  <name>dev24-win-test</name>
  <memory unit="GiB">4</memory>
  <vcpu>2</vcpu>
  <os firmware="efi">
    <type arch="x86_64" machine="q35">hvm</type>
    <!-- Windows 11 requires UEFI + Secure Boot; libvirt picks the matching
         OVMF Secure-Boot firmware from these feature hints (provided by the
         `ovmf` package) and allocates per-domain nvram automatically. -->
    <loader secure="yes"/>
    <firmware>
      <feature enabled="yes" name="enrolled-keys"/>
      <feature enabled="yes" name="secure-boot"/>
    </firmware>
    <boot dev="hd"/>
  </os>
  <features>
    <acpi/>
    <apic/>
    <smm state="on"/>  <!-- required for Secure Boot -->
    <hyperv mode="custom">
      <relaxed state="on"/>
      <vapic state="on"/>
      <spinlocks state="on" retries="8191"/>
    </hyperv>
  </features>
  <cpu mode="host-model"/>
  <clock offset="localtime">
    <timer name="hypervclock" present="yes"/>
  </clock>
  <devices>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/>
      <!-- Placeholder paths — harness.py patches the disk/cdrom sources at
           runtime from OVERLAY_IMAGE / CONTROL_ISO. -->
      <source file="/opt/dev24-vm/go1.qcow2"/>
      <target dev="vda" bus="virtio"/>
    </disk>
    <!-- Per-run control CD (MAINTCD): ubootstrap.ps1 / cboot1.ps1 / check-req.py
         + fixture. Built and path-patched by harness.py; auto-mounts in Windows. -->
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="/opt/dev24-vm/maintcd.iso"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
    </disk>
    <interface type="network">
      <source network="default"/>
      <model type="virtio"/>
    </interface>
    <graphics type="spice" autoport="yes"/>
    <video>
      <model type="qxl"/>
    </video>
    <channel type="spicevmc">
      <target type="virtio" name="com.redhat.spice.0"/>
    </channel>
    <!-- Windows 11 requires TPM 2.0; emulated via swtpm -->
    <tpm model="tpm-crb">
      <backend type="emulator" version="2.0"/>
    </tpm>
  </devices>
</domain>
